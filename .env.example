# ─────────────────────────────────────────────────────────────
# Nordverkehr Support-Center – Umgebungsvariablen
# Lokal nach .env kopieren, auf Vercel unter Settings → Environment Variables.
# NIEMALS echte Werte committen. Erklärung jeder Variable: README → „Umgebungsvariablen“.
# ─────────────────────────────────────────────────────────────

# ─── Öffentliche Adressen ───
NEXT_PUBLIC_APP_URL="https://support.nordverkehr.xyz"
NEXT_PUBLIC_MAIN_SITE_URL="https://nordverkehr.xyz"
NEXT_PUBLIC_BEWERBUNG_URL="https://bewerbung.nordverkehr.xyz"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/KrfKASTHDp"
# NEXT_PUBLIC_RULES_URL="https://nordverkehr.xyz/regeln"
# Tebex-Shop (optional) – zeigt Shop, AGB, Impressum und Datenschutz von Tebex im Footer
# NEXT_PUBLIC_SHOP_URL="https://nordverkehr.tebex.io"

# ─── Datenbank: PostgreSQL (Neon) ───
# Auf Vercel setzt die Neon-Integration DATABASE_URL (gepoolt) und
# DATABASE_URL_UNPOOLED (direkt, für Schema-Änderungen) automatisch.
# Lokal (npm run db:dev):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/nordverkehr_support"
# Optional: direkte Verbindung ohne Pooler (sonst wird DATABASE_URL genommen)
# DATABASE_URL_UNPOOLED=""

# ─── Login (Auth.js + Discord-OAuth) ───
# Erzeugen: npx auth secret   oder   openssl rand -base64 32
AUTH_SECRET=""
# Discord Developer Portal → (dieselbe App „NV Lotse“) → OAuth2
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_TRUST_HOST="true"

# ─── Discord-Bot „NV Lotse“ (derselbe Bot/Token wie im Bewerbungsportal) ───
DISCORD_BOT_TOKEN=""
# Optional: Public Key der App (sonst wird er per Bot-Token abgefragt)
DISCORD_PUBLIC_KEY=""
DISCORD_GUILD_ID=""
# Team-Rollen (höchste zählt): Support < Moderation < Leitung
SUPPORT_ROLE_ID=""
MODERATION_ROLE_ID=""
LEITUNG_ROLE_ID=""
# Text-Channel für das Ticket-Panel
DISCORD_TICKET_CHANNEL_ID=""
# Log-Channel für neue Tickets/Anträge und Entscheidungen (optional)
DISCORD_LOG_CHANNEL_ID=""
# Weiterleitung aller Interaktionen, die nicht zum Support gehören (Bewerbungsportal)
INTERACTIONS_FORWARD_URL="https://bewerbung.nordverkehr.xyz/api/discord/interactions"
# Rollen-/Bann-Cache in Sekunden
ROLE_CACHE_TTL_SECONDS="60"
BAN_CACHE_TTL_SECONDS="300"

# ─── Cron (Vercel schickt "Authorization: Bearer <CRON_SECRET>") ───
CRON_SECRET=""

# ─── IDs ───
TICKET_ID_PREFIX="NVS"
REQUEST_ID_PREFIX="NVA"

# ─── Statusseite (optional) ───
# Entweder direkte Server-Adresse (dynamic.json/players.json) …
FIVEM_SERVER_URL=""
# … oder der cfx.re-Join-Code (z. B. "abc123")
FIVEM_CFX_CODE=""
# TeamSpeak: entweder WebQuery (TS3 ≥ 3.12) …
TEAMSPEAK_WEBQUERY_URL=""
TEAMSPEAK_WEBQUERY_KEY=""
# … oder nur Erreichbarkeit per TCP (Host + Port, z. B. 10011 oder 30033)
TEAMSPEAK_HOST=""
TEAMSPEAK_PORT="10011"

# ─── KI (optional, kostenpflichtig) – Anthropic Claude, nur Entwürfe fürs Team ───
ANTHROPIC_API_KEY=""

# ─── Live-Nachrichten sofort (optional, empfohlen) ───
# Pusher Channels (pusher.com, kostenloser Sandbox-Plan reicht). Ohne diese
# Werte fragen die Seiten alle paar Sekunden nach (funktioniert, aber 2–4 s Verzögerung).
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
# Selbst gehostet (z. B. Soketi) statt pusher.com:
# PUSHER_HOST=""  PUSHER_PORT=""  PUSHER_USE_TLS="true"
# NEXT_PUBLIC_PUSHER_HOST=""  NEXT_PUBLIC_PUSHER_PORT=""  NEXT_PUBLIC_PUSHER_TLS="true"
AI_MODEL_DEFAULT="claude-sonnet-5-5"
AI_MODEL_FAST="claude-haiku-5-5"

# ─── NUR lokal: Login als Demo-Nutzer ohne Discord (in Produktion wirkungslos) ───
# DEV_LOGIN="true"
